{
  "name": "busapp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run start -w apps/mobile",
    "dev:api": "cd src && dotnet run --project BusApp.Api",
    "build:api": "cd src && dotnet build",
    "build:web": "npm run build -w apps/web",
    "build": "cd src && dotnet build && npm run build -w apps/web",
    "lint:web": "npm run lint -w apps/web",
    "typecheck:mobile": "npm run typecheck -w apps/mobile"
  }
}
